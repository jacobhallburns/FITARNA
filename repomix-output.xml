<file path="Website/public/assets/css/base.css">
* { box-sizing: border-box; }

html, body { height: 100%; }

body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--text);
  font: 16px/1.5 system-ui, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
}

a { color: var(--primary); text-decoration: none; }
a:hover { opacity: 0.9; }

/* Card */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 1rem 1.1rem;
  box-shadow: var(--shadow);
}

/* Muted text */
.muted { color: var(--muted); }

/* Button */
.btn {
  display: inline-block;
  background: var(--primary);
  color: #fff;
  padding: .65rem 1rem;
  border-radius: 12px;
  border: 1px solid transparent;
  text-decoration: none;
  font-weight: 600;
  transition: transform .04s ease, box-shadow .2s ease, background .2s ease;
  box-shadow: 0 4px 10px rgba(0,0,0,.08);
}
.btn:hover { transform: translateY(-1px); }
.btn:active { transform: translateY(0); }
.btn:focus-visible {
  outline: none;
  box-shadow: 0 0 0 4px var(--ring);
}

/* Input + select */
input, select, textarea {
  width: 100%;
  padding: .6rem .7rem;
  color: var(--text);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  outline: none;
  transition: box-shadow .15s ease, border-color .15s ease;
}
input:focus, select:focus, textarea:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 4px var(--ring);
}

/* Badge */
.badge {
  display: inline-block;
  background: color-mix(in oklab, var(--accent) 22%, transparent);
  color: var(--text);
  border: 1px solid var(--accent);
  padding: .25rem .5rem;
  border-radius: 999px;
  font-size: .85rem;
}

/* Contact button */
.contact-btn {
  display: inline-block;
  width: fit-content;
  margin: 5px auto;
  padding: 0.8rem 1.6rem;
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 12px;
  font-weight: 600;
  font-size: 1.1rem;
  cursor: pointer;
  text-decoration: none;
  transition: transform 0.08s ease, box-shadow 0.2s ease, background 0.2s ease;
  box-shadow: var(--shadow);
}
.contact-btn:hover {
  background: color-mix(in oklab, var(--primary) 85%, black);
  transform: translateY(-2px);
}
.contact-btn:active {
  transform: translateY(0);
}

/* Footer */
footer {
  margin-top: 60px;
  padding: 24px 16px;
  text-align: center;
  background: var(--surface);
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 0.9rem;
}
</file>

<file path="Website/webpages/about_us.html">
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>About Us — FITARNA</title>
    <meta name="description" content="Meet the FITARNA senior design team at Florida Institute of Technology." />

    <!-- Prevent theme flash + default first visit to LIGHT -->
    <script>
    (function () {
        var t = localStorage.getItem('site-theme');
        if (t !== 'light' && t !== 'dark') { t = 'light'; try { localStorage.setItem('site-theme', t); } catch {} }
        if (t === 'dark') document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', t);
    })();
    </script>

    <link rel="stylesheet" href="../assets/css/theme-tokens.css">
    <link rel="stylesheet" href="../assets/css/base.css">
    <link rel="stylesheet" href="../assets/css/navbar.css">

    <style>
        .page-hero {
            max-width: 800px;
            margin: 60px auto 48px;
            padding: 0 16px;
            text-align: center;
        }
        .page-hero h1 {
            font-size: 2.6rem;
            font-weight: 800;
            color: var(--primary);
            margin: 0 0 16px;
            letter-spacing: -0.5px;
        }
        .page-hero .subtitle {
            font-size: 1.15rem;
            color: var(--muted);
            max-width: 580px;
            margin: 0 auto;
            line-height: 1.7;
        }
        .divider {
            width: 60px;
            height: 4px;
            background: var(--accent);
            border-radius: 2px;
            margin: 24px auto;
        }

        .section {
            max-width: 960px;
            margin: 0 auto 64px;
            padding: 0 16px;
        }
        .section-title {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary);
            margin: 0 0 24px;
            text-align: center;
        }

        /* Team grid */
        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 24px;
        }
        .member-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 1.6rem 1.2rem 1.4rem;
            box-shadow: var(--shadow);
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }
        .member-avatar {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: color-mix(in oklab, var(--accent) 30%, var(--surface));
            border: 2px solid var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 4px;
            flex-shrink: 0;
        }
        .member-name {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--text);
            margin: 0;
        }
        .member-role {
            font-size: 0.85rem;
            color: var(--primary);
            font-weight: 600;
            margin: 0;
        }
        .member-bio {
            font-size: 0.88rem;
            color: var(--muted);
            line-height: 1.6;
            margin: 4px 0 0;
        }
        .member-links {
            display: flex;
            gap: 10px;
            margin-top: 8px;
            flex-wrap: wrap;
            justify-content: center;
        }
        .member-links a {
            font-size: 0.82rem;
            color: var(--primary);
            text-decoration: underline;
        }

        /* Advisor card */
        .advisor-card {
            background: var(--surface);
            border: 2px solid var(--accent);
            border-radius: 16px;
            padding: 1.8rem 2rem;
            box-shadow: var(--shadow);
            display: flex;
            gap: 24px;
            align-items: flex-start;
            max-width: 680px;
            margin: 0 auto;
        }
        .advisor-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: color-mix(in oklab, var(--accent) 30%, var(--surface));
            border: 2px solid var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 700;
            color: var(--primary);
            flex-shrink: 0;
        }
        .advisor-info h3 {
            font-size: 1.15rem;
            font-weight: 700;
            margin: 0 0 4px;
        }
        .advisor-info .advisor-title {
            font-size: 0.9rem;
            color: var(--primary);
            font-weight: 600;
            margin: 0 0 10px;
        }
        .advisor-info p {
            font-size: 0.92rem;
            color: var(--muted);
            margin: 0;
            line-height: 1.65;
        }

        /* University card */
        .uni-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 2rem;
            box-shadow: var(--shadow);
            text-align: center;
        }
        .uni-card h3 {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--primary);
            margin: 0 0 8px;
