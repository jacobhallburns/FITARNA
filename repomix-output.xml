<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Mission — FITARNA</title>
    <meta name="description" content="The mission and goals of the FITARNA Indoor AR Navigation project." />

    <!-- Prevent theme flash + default first visit to LIGHT -->
